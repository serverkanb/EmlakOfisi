<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.14" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- Testler sırayla çalışır (bu makinede bellek az; paralel çalışınca OutOfMemory veriyordu) -->
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EmlakOfisi.BusinessLayer\EmlakOfisi.BusinessLayer.csproj" />
    <ProjectReference Include="..\EmlakOfisi.DataAccessLayer\EmlakOfisi.DataAccessLayer.csproj" />
    <ProjectReference Include="..\EmlakOfisi.WebUI\EmlakOfisi.WebUI.csproj" />
  </ItemGroup>

</Project>
