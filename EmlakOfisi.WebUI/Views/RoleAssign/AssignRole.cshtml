@model AssignRolePageViewModel
@{
    ViewData["Title"] = "Rol atama";
}

<div class="card" style="max-width: 480px;">
    <div class="card-header">
        <h3 class="card-title">@Model.FullName</h3>
    </div>
    <div class="card-body">
        <p class="text-secondary small">En az bir rol seçili olmalıdır.</p>
        <form method="post" asp-action="AssignRole" asp-route-id="@Model.UserId">
            @for (int i = 0; i < Model.Roles.Count; i++)
            {
                @* İşaretsiz kutu hiçbir şey göndermez; RoleExist o zaman false kalır *@
                <input type="hidden" name="roles[@i].RoleName" value="@Model.Roles[i].RoleName" />
                <label class="form-check form-switch py-2">
                    <input class="form-check-input" type="checkbox" name="roles[@i].RoleExist" value="true" @(Model.Roles[i].RoleExist ? "checked" : "") />
                    <span class="form-check-label">@Model.Roles[i].RoleLabel</span>
                </label>
            }

            <div class="d-flex gap-2 mt-3">
                <button type="submit" class="btn btn-primary"><i class="ti ti-device-floppy me-1"></i> Kaydet</button>
                <a asp-controller="AdminUser" asp-action="Index" class="btn btn-link">Vazgeç</a>
            </div>
        </form>
    </div>
</div>
