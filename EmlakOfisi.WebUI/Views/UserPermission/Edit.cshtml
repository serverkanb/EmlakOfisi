@model UserPermissionPageViewModel
@{
    ViewData["Title"] = "İzinler";
}

<div class="card" style="max-width: 560px;">
    <div class="card-header">
        <h3 class="card-title">@Model.FullName</h3>
    </div>
    <div class="card-body">
        @if (Model.CanSeeAll)
        {
            <div class="alert alert-info" role="alert">
                Bu kullanıcı yönetici; bu işlemleri izin olmadan da yapabilir.
            </div>
        }
        <p class="text-secondary small">
            İzinler görünürlüğü değiştirmez: kullanıcı başka danışmanların "Sadece Ben" kayıtlarını yine göremez.
        </p>
        <form method="post" asp-action="Edit" asp-route-id="@Model.UserId">
            @foreach (var p in Model.Permissions)
            {
                <label class="form-check form-switch py-2 mb-2">
                    <input class="form-check-input" type="checkbox" name="permissions" value="@p.Name" @(p.Granted ? "checked" : "") />
                    <span class="form-check-label fw-bold">@p.Label</span>
                    <span class="d-block text-secondary small">@p.Description</span>
                </label>
            }

            <div class="d-flex gap-2 mt-3">
                <button type="submit" class="btn btn-primary"><i class="ti ti-device-floppy me-1"></i> Kaydet</button>
                <a asp-controller="AdminUser" asp-action="Index" class="btn btn-link">Vazgeç</a>
            </div>
        </form>
    </div>
</div>
