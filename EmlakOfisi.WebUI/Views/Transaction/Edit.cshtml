@model TransactionFormViewModel
@{
    ViewData["Title"] = "İşlemi düzenle";
    var options = (TransactionFormOptions)ViewBag.Options;
}

<div class="card" style="max-width: 900px;">
    <div class="card-body">
        <form method="post" asp-action="Edit" asp-route-id="@options.TransactionId">
            <partial name="_TransactionForm" model="Model" />

            <div class="d-flex gap-2 mt-4">
                <button type="submit" class="btn btn-primary btn-lg flex-fill flex-sm-grow-0">
                    <i class="ti ti-device-floppy me-1"></i> Kaydet
                </button>
                <a asp-action="Index" class="btn btn-link btn-lg">Vazgeç</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
