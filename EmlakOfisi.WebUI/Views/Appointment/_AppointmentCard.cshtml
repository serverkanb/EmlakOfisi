@using EmlakOfisi.EntityLayer.Enums
@model AppointmentItemViewModel
@{
    var scope = ViewData["Scope"] as AppointmentScope? ?? AppointmentScope.Upcoming;
    var mine = ViewData["Mine"] as bool? ?? false;
}

@* Bir randevu kartı. Bağlı müşteri/portföy görünmüyorsa sadece "Gizli kayıt" yazar (ad, telefon, id yok). *@
<div class="card @(Model.Status == AppointmentStatus.Cancelled ? "opacity-75" : "")">
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-start gap-2">
            <div>
                <div class="fs-2 fw-bold">@Model.TimeText</div>
                <div class="d-flex flex-wrap gap-1 mt-1">
                    <span class="badge @(Model.Type == AppointmentType.Showing ? "bg-orange-lt" : "bg-blue-lt")">
                        <i class="ti @(Model.Type == AppointmentType.Showing ? "ti-home-search" : "ti-messages") me-1"></i>@AppointmentLabels.Type(Model.Type)
                    </span>
                    @if (Model.Status != AppointmentStatus.Planned)
                    {
                        <span class="badge @(Model.Status == AppointmentStatus.Done ? "bg-green-lt" : "bg-secondary-lt")">@AppointmentLabels.Status(Model.Status)</span>
                    }
                    else if (Model.StartAt.Date < DateTime.Today)
                    {
                        @* Tarihi geçti ama "Yapıldı" ya da "İptal" işaretlenmedi *@
                        <span class="badge bg-yellow-lt">Sonuçlanmadı</span>
                    }
                </div>
            </div>
            <div class="text-end text-secondary small">
                <i class="ti ti-user me-1"></i>@(Model.IsMine ? "Ben" : Model.AgentName)
            </div>
        </div>

        <div class="mt-3 d-flex flex-column gap-2">
            @if (Model.ContactName != null)
            {
                <div class="d-flex flex-wrap align-items-center gap-2">
                    <a asp-controller="Contact" asp-action="Detail" asp-route-id="@Model.ContactId" class="fw-bold d-inline-block py-2">
                        <i class="ti ti-user-circle me-1"></i>@Model.ContactName
                    </a>
                    @if (Model.TelLink.Length > 0)
                    {
                        <a href="@Model.TelLink" class="btn btn-outline-primary icon-touch" aria-label="Ara"><i class="ti ti-phone"></i></a>
                        <a href="@Model.WhatsAppLink" target="_blank" rel="noopener" class="btn btn-outline-success icon-touch" aria-label="WhatsApp"><i class="ti ti-brand-whatsapp"></i></a>
                    }
                </div>
            }
            else if (Model.ContactHidden)
            {
                <div class="text-secondary"><i class="ti ti-lock me-1"></i>Müşteri: gizli kayıt</div>
            }

            @if (Model.PropertyTitle != null)
            {
                <div class="d-flex flex-wrap align-items-center gap-2">
                    <a asp-controller="Property" asp-action="Detail" asp-route-id="@Model.PropertyId" class="text-break">
                        <i class="ti ti-building-community me-1"></i>@Model.PropertyTitle
                    </a>
                    @if (Model.MapLink != null)
                    {
                        <a href="@Model.MapLink" target="_blank" rel="noopener" class="btn btn-outline-primary icon-touch" aria-label="Haritada aç"><i class="ti ti-map-2"></i></a>
                    }
                </div>
            }
            else if (Model.PropertyHidden)
            {
                <div class="text-secondary"><i class="ti ti-lock me-1"></i>Portföy: gizli kayıt</div>
            }

            @if (!string.IsNullOrWhiteSpace(Model.Location))
            {
                <div class="text-secondary text-break"><i class="ti ti-map-pin me-1"></i>@Model.Location</div>
            }
            @if (!string.IsNullOrWhiteSpace(Model.Notes))
            {
                <div class="text-break small" style="white-space: pre-line;">@Model.Notes</div>
            }
        </div>

        @if (Model.CanEdit)
        {
            <div class="d-flex flex-wrap gap-2 mt-3">
                <a asp-action="Edit" asp-route-id="@Model.AppointmentId" class="btn btn-outline-primary">
                    <i class="ti ti-pencil me-1"></i> Düzenle
                </a>
                @if (Model.Status == AppointmentStatus.Planned)
                {
                    <form method="post" asp-action="SetStatus" asp-route-id="@Model.AppointmentId">
                        <input type="hidden" name="status" value="@AppointmentStatus.Done" />
                        <input type="hidden" name="scope" value="@scope" />
                        <input type="hidden" name="mine" value="@(mine ? "true" : "false")" />
                        <button type="submit" class="btn btn-outline-success"><i class="ti ti-check me-1"></i> Yapıldı</button>
                    </form>
                    <form method="post" asp-action="SetStatus" asp-route-id="@Model.AppointmentId"
                          onsubmit="return confirm('Bu randevu iptal edilsin mi?');">
                        <input type="hidden" name="status" value="@AppointmentStatus.Cancelled" />
                        <input type="hidden" name="scope" value="@scope" />
                        <input type="hidden" name="mine" value="@(mine ? "true" : "false")" />
                        <button type="submit" class="btn btn-outline-danger"><i class="ti ti-x me-1"></i> İptal</button>
                    </form>
                }
                else if (Model.StartAt.Date < DateTime.Today)
                {
                    @* Tarihi geçmiş randevu sadece durumla "yaklaşan" olmaz: yeni tarih için düzenlemeye gider *@
                    <a asp-action="Edit" asp-route-id="@Model.AppointmentId" class="btn btn-outline-secondary">
                        <i class="ti ti-rotate me-1"></i> Tekrar planla
                    </a>
                }
                else
                {
                    <form method="post" asp-action="SetStatus" asp-route-id="@Model.AppointmentId">
                        <input type="hidden" name="status" value="@AppointmentStatus.Planned" />
                        <input type="hidden" name="scope" value="@scope" />
                        <input type="hidden" name="mine" value="@(mine ? "true" : "false")" />
                        <button type="submit" class="btn btn-outline-secondary"><i class="ti ti-rotate me-1"></i> Tekrar planla</button>
                    </form>
                }
            </div>
        }
    </div>
</div>
