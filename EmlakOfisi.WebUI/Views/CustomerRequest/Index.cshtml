@using EmlakOfisi.EntityLayer.Enums
@model CustomerRequestListViewModel
@{
    ViewData["Title"] = "Talepler";
}

@* Görebildiğin müşterilerin talepleri. Yeni bir ilan gelince "bunu kim arıyordu?" sorusu için.
   Talep, müşteri detayından eklenir ve düzenlenir. *@
<form method="get" asp-action="Index" class="contact-search mb-2" role="search">
    <div class="input-group input-group-lg">
        <span class="input-group-text"><i class="ti ti-search"></i></span>
        <input type="search" name="q" value="@Model.Q" class="form-control" placeholder="Şehir veya ilçe" aria-label="Talep ara" autocomplete="off" />
        <button type="submit" class="btn btn-primary">Ara</button>
    </div>
    <div class="row g-2 mt-1">
        <div class="col-4">
            <select name="listingType" class="form-select form-select-lg" aria-label="Satılık / kiralık" onchange="this.form.submit()">
                <option value="">Satılık / kiralık</option>
                <option value="Sale" selected="@(Model.ListingType == ListingType.Sale)">Satılık</option>
                <option value="Rent" selected="@(Model.ListingType == ListingType.Rent)">Kiralık</option>
            </select>
        </div>
        <div class="col-4">
            <select name="propertyType" class="form-select form-select-lg" aria-label="Tür" onchange="this.form.submit()">
                <option value="">Tüm türler</option>
                @foreach (var t in new[] { PropertyType.Residence, PropertyType.Land, PropertyType.Commercial, PropertyType.Other })
                {
                    <option value="@t" selected="@(Model.PropertyType == t)">@PropertyLabels.Type(t)</option>
                }
            </select>
        </div>
        <div class="col-4">
            <select name="status" class="form-select form-select-lg" aria-label="Durum" onchange="this.form.submit()">
                <option value="Open" selected="@(Model.Status == RequestStatus.Open)">Açık</option>
                <option value="Closed" selected="@(Model.Status == RequestStatus.Closed)">Kapanan</option>
                <option value="all" selected="@(Model.Status == null)">Tümü</option>
            </select>
        </div>
    </div>
</form>

<div class="text-secondary small mb-2">@Model.TotalCount talep</div>

@if (Model.Items.Count == 0)
{
    <div class="empty">
        <div class="empty-icon"><i class="ti ti-home-search fs-1"></i></div>
        <p class="empty-title">Talep bulunamadı</p>
        <p class="empty-subtitle text-secondary">Talepler müşteri detayından eklenir.</p>
    </div>
}
else
{
    <div class="card">
        <div class="list-group list-group-flush">
            @foreach (var item in Model.Items)
            {
                <partial name="_RequestCard" model="item" view-data='new ViewDataDictionary(ViewData) { ["ShowContact"] = true }' />
            }
        </div>
    </div>

    @if (Model.TotalPages > 1)
    {
        var statusValue = Model.Status?.ToString() ?? "all";
        <nav class="d-flex justify-content-between align-items-center mt-3" aria-label="Sayfalar">
            @if (Model.Page > 1)
            {
                <a asp-action="Index" asp-route-q="@Model.Q" asp-route-listingType="@Model.ListingType" asp-route-propertyType="@Model.PropertyType"
                   asp-route-status="@statusValue" asp-route-page="@(Model.Page - 1)" class="btn btn-outline-secondary"><i class="ti ti-chevron-left me-1"></i> Önceki</a>
            }
            else
            {
                <span></span>
            }
            <span class="text-secondary">Sayfa @Model.Page / @Model.TotalPages</span>
            @if (Model.Page < Model.TotalPages)
            {
                <a asp-action="Index" asp-route-q="@Model.Q" asp-route-listingType="@Model.ListingType" asp-route-propertyType="@Model.PropertyType"
                   asp-route-status="@statusValue" asp-route-page="@(Model.Page + 1)" class="btn btn-outline-secondary">Sonraki <i class="ti ti-chevron-right ms-1"></i></a>
            }
            else
            {
                <span></span>
            }
        </nav>
    }
}
