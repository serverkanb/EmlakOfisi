@using EmlakOfisi.EntityLayer.Enums
@model CustomerRequestItemViewModel
@{
    var showContact = ViewData["ShowContact"] as bool? == true;
}

@* Bir talep. Müşteri listede ("Talepler") gösterilir; müşteri detayında gerekmez. *@
<div class="list-group-item @(Model.Status == RequestStatus.Closed ? "opacity-75" : "")">
    <div class="d-flex justify-content-between align-items-start gap-2">
        <div class="fw-bold text-break">@Model.Summary</div>
        @if (Model.Status == RequestStatus.Closed)
        {
            <span class="badge bg-secondary-lt">Kapandı</span>
        }
    </div>
    @if (Model.PriceText != null)
    {
        <div class="ak-price fw-bold">@Model.PriceText</div>
    }
    @if (showContact)
    {
        <div class="d-flex flex-wrap align-items-center gap-2 mt-1">
            <a asp-controller="Contact" asp-action="Detail" asp-route-id="@Model.ContactId" asp-fragment="talepler" class="d-inline-block py-2">
                <i class="ti ti-user-circle me-1"></i>@Model.ContactName
            </a>
            @if (Model.TelLink.Length > 0)
            {
                <a href="@Model.TelLink" class="btn btn-outline-primary icon-touch" aria-label="Ara"><i class="ti ti-phone"></i></a>
                <a href="@Model.WhatsAppLink" target="_blank" rel="noopener" class="btn btn-outline-success icon-touch" aria-label="WhatsApp"><i class="ti ti-brand-whatsapp"></i></a>
            }
        </div>
    }
    @if (!string.IsNullOrWhiteSpace(Model.Notes))
    {
        <div class="text-break small mt-1" style="white-space: pre-line;">@Model.Notes</div>
    }
    <div class="text-secondary small mt-1">@Model.CreatedAt.ToString("dd.MM.yyyy") · @Model.CreatedByName</div>

    <div class="d-flex flex-wrap gap-2 mt-2">
        @if (Model.Status == RequestStatus.Open)
        {
            <a asp-controller="Property" asp-action="Index" asp-all-route-data="Model.MatchRoute" class="btn btn-outline-primary">
                <i class="ti ti-search me-1"></i> Uygun portföyler
            </a>
        }
        @if (Model.CanEdit)
        {
            <a asp-controller="CustomerRequest" asp-action="Edit" asp-route-id="@Model.CustomerRequestId" class="btn btn-outline-secondary">
                <i class="ti ti-pencil me-1"></i> Düzenle
            </a>
            <form method="post" asp-controller="CustomerRequest" asp-action="SetStatus" asp-route-id="@Model.CustomerRequestId">
                @if (Model.Status == RequestStatus.Open)
                {
                    <input type="hidden" name="status" value="@RequestStatus.Closed" />
                    <button type="submit" class="btn btn-outline-secondary"><i class="ti ti-circle-check me-1"></i> Kapat</button>
                }
                else
                {
                    <input type="hidden" name="status" value="@RequestStatus.Open" />
                    <button type="submit" class="btn btn-outline-secondary"><i class="ti ti-rotate me-1"></i> Yeniden aç</button>
                }
            </form>
        }
    </div>
</div>
