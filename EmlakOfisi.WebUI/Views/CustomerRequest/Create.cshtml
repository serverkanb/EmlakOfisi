@model CustomerRequestFormViewModel
@{
    ViewData["Title"] = "Yeni talep";
}

<div class="card" style="max-width: 900px;">
    <div class="card-header">
        <h3 class="card-title"><i class="ti ti-user me-1"></i> @ViewBag.ContactName</h3>
    </div>
    <div class="card-body">
        <form method="post" asp-action="Create" asp-route-contactId="@ViewBag.ContactId">
            <partial name="_RequestForm" model="Model" />

            <div class="d-flex gap-2 mt-4">
                <button type="submit" class="btn btn-primary btn-lg flex-fill flex-sm-grow-0">
                    <i class="ti ti-device-floppy me-1"></i> Kaydet
                </button>
                <a asp-controller="Contact" asp-action="Detail" asp-route-id="@ViewBag.ContactId" class="btn btn-link btn-lg">Vazgeç</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
