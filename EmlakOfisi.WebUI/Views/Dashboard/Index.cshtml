@using EmlakOfisi.EntityLayer.Enums
@model DashboardViewModel
@{
    ViewData["Title"] = "Ana sayfa";
}

@* Sayılar kullanıcının görebildiği kayıtlardan gelir. Kartlar ilgili listeyi filtreli açar. *@
<div class="row row-cards">
    <div class="col-6 col-lg-3">
        <a class="card card-sm card-link text-reset text-decoration-none h-100"
           asp-controller="Property" asp-action="Index" asp-route-status="@PropertyStatus.Active">
            <div class="card-body d-flex align-items-center gap-3">
                <span class="avatar bg-primary-lt"><i class="ti ti-building-community"></i></span>
                <div>
                    <div class="text-secondary small">Aktif portföy</div>
                    <div class="h2 m-0">@Model.ActiveProperties</div>
                </div>
            </div>
        </a>
    </div>
    <div class="col-6 col-lg-3">
        <a class="card card-sm card-link text-reset text-decoration-none h-100"
           asp-controller="Contact" asp-action="Index">
            <div class="card-body d-flex align-items-center gap-3">
                <span class="avatar bg-green-lt"><i class="ti ti-users"></i></span>
                <div>
                    <div class="text-secondary small">Müşteri</div>
                    <div class="h2 m-0">@Model.Contacts</div>
                </div>
            </div>
        </a>
    </div>
    <div class="col-6 col-lg-3">
        <a class="card card-sm card-link text-reset text-decoration-none h-100"
           asp-controller="Property" asp-action="Index" asp-route-status="@PropertyStatus.Active" asp-route-listingType="@ListingType.Sale">
            <div class="card-body d-flex align-items-center gap-3">
                <span class="avatar bg-orange-lt"><i class="ti ti-home-dollar"></i></span>
                <div>
                    <div class="text-secondary small">Satılık (aktif)</div>
                    <div class="h2 m-0">@Model.ActiveSale</div>
                </div>
            </div>
        </a>
    </div>
    <div class="col-6 col-lg-3">
        <a class="card card-sm card-link text-reset text-decoration-none h-100"
           asp-controller="Property" asp-action="Index" asp-route-status="@PropertyStatus.Active" asp-route-listingType="@ListingType.Rent">
            <div class="card-body d-flex align-items-center gap-3">
                <span class="avatar bg-purple-lt"><i class="ti ti-key"></i></span>
                <div>
                    <div class="text-secondary small">Kiralık (aktif)</div>
                    <div class="h2 m-0">@Model.ActiveRent</div>
                </div>
            </div>
        </a>
    </div>
</div>

@* Bu ay tamamlanan işlemler ve komisyon (görev 18): danışman kendi işlemlerini, yönetici tüm ofisi görür *@
<a class="card mt-3 card-link text-reset text-decoration-none" asp-controller="Transaction" asp-action="Index" asp-route-scope="@TransactionScope.Completed">
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-center mb-2">
            <div class="fw-bold"><i class="ti ti-receipt me-1"></i> Bu ay (@DateTime.Today.ToString("MMMM yyyy", PropertyLabels.Tr))</div>
            <span class="text-secondary small">@(Model.CanSeeAll ? "Ofis geneli" : "Sizin işlemleriniz")</span>
        </div>
        <div class="row g-2 text-center">
            <div class="col-6 col-md-3">
                <div class="text-secondary small">Satış</div>
                <div class="h2 m-0">@Model.MonthSaleCount</div>
            </div>
            <div class="col-6 col-md-3">
                <div class="text-secondary small">Kiralama</div>
                <div class="h2 m-0">@Model.MonthRentCount</div>
            </div>
            <div class="col-6 col-md-3">
                <div class="text-secondary small">Komisyon</div>
                <div class="h3 m-0 ak-price text-nowrap">@TransactionLabels.Money(Model.MonthCommission)</div>
            </div>
            <div class="col-6 col-md-3">
                <div class="text-secondary small">@(Model.CanSeeAll ? "Ödenecek primler" : "Primim")</div>
                <div class="h3 m-0 ak-price text-nowrap">@TransactionLabels.Money(Model.MonthAgentShare)</div>
            </div>
        </div>
    </div>
</a>

<div class="row row-cards mt-1">
    <div class="col-12 col-lg-6">
        <div class="card h-100">
            <div class="card-header"><h3 class="card-title">Portföy durumları</h3></div>
            <div class="list-group list-group-flush">
                @{
                    var rows = new (PropertyStatus Status, int Count)[]
                    {
                        (PropertyStatus.Active, Model.ActiveProperties),
                        (PropertyStatus.Passive, Model.PassiveProperties),
                        (PropertyStatus.Sold, Model.SoldProperties),
                        (PropertyStatus.Rented, Model.RentedProperties)
                    };
                }
                @foreach (var r in rows)
                {
                    <a class="list-group-item list-group-item-action d-flex justify-content-between align-items-center dashboard-row"
                       asp-controller="Property" asp-action="Index" asp-route-status="@r.Status">
                        <span>@PropertyLabels.Status(r.Status)</span>
                        <span class="fw-bold">@r.Count</span>
                    </a>
                }
            </div>
        </div>
    </div>
    <div class="col-12 col-lg-6">
        <div class="card h-100">
            <div class="card-header">
                <h3 class="card-title">Yaklaşan randevular</h3>
                <span class="badge bg-primary-lt ms-auto">@Model.UpcomingCount</span>
            </div>
            @if (Model.Upcoming.Count == 0)
            {
                <div class="card-body text-secondary">
                    <i class="ti ti-calendar-event me-1"></i> Yaklaşan randevu yok.
                </div>
            }
            else
            {
                <div class="list-group list-group-flush">
                    @foreach (var a in Model.Upcoming)
                    {
                        @* Bağlı kayıt görünmüyorsa adı gösterilmez *@
                        <a asp-controller="Appointment" asp-action="Index" class="list-group-item list-group-item-action dashboard-row">
                            <div class="d-flex justify-content-between gap-2">
                                <span class="fw-bold text-nowrap">@a.StartAt.ToString("dd.MM ddd HH:mm", PropertyLabels.Tr)</span>
                                <span class="text-secondary small text-end">@AppointmentLabels.Type(a.Type)@(a.IsMine ? "" : " · " + a.AgentName)</span>
                            </div>
                            <div class="text-secondary small text-truncate">
                                @a.LinkSummary
                            </div>
                        </a>
                    }
                </div>
            }
            <div class="card-footer">
                <a asp-controller="Appointment" asp-action="Index" class="btn btn-link px-0">Tüm randevular <i class="ti ti-chevron-right"></i></a>
            </div>
        </div>
    </div>
    <div class="col-12">
        @* Biten kira kontratları (görev 23). Görünmeyen portföy/kiracı için ad yazılmaz; komisyon gösterilmez. *@
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">Biten kira kontratları</h3>
                <span class="badge bg-primary-lt ms-auto">@Model.LeaseEndingCount</span>
            </div>
            @if (Model.LeaseEnding.Count == 0)
            {
                <div class="card-body text-secondary">
                    <i class="ti ti-calendar-check me-1"></i> Yakında biten kira yok.
                </div>
            }
            else
            {
                <div class="list-group list-group-flush">
                    @foreach (var l in Model.LeaseEnding)
                    {
                        var badge = TransactionLabels.LeaseBadge(l.Type, l.Status, l.LeaseEndDate);
                        <div class="list-group-item">
                            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
                                <span class="fw-bold text-nowrap">@l.LeaseEndDate?.ToString("dd.MM.yyyy")</span>
                                @if (badge is { } b)
                                {
                                    <span class="badge @b.Css">@b.Text</span>
                                }
                            </div>
                            <div class="mt-1">
                                @if (l.PropertyTitle != null)
                                {
                                    <a asp-controller="Property" asp-action="Detail" asp-route-id="@l.PropertyId" class="text-break d-inline-flex align-items-center touch-link">
                                        <i class="ti ti-building-community me-1"></i>@l.PropertyTitle
                                    </a>
                                }
                                else
                                {
                                    <span class="text-secondary"><i class="ti ti-lock me-1"></i>Portföy: gizli kayıt</span>
                                }
                            </div>
                            <div class="d-flex flex-wrap align-items-center gap-2">
                                @if (l.ContactName != null)
                                {
                                    <a asp-controller="Contact" asp-action="Detail" asp-route-id="@l.ContactId" class="d-inline-flex align-items-center touch-link">
                                        <i class="ti ti-user-circle me-1"></i>@l.ContactName
                                    </a>
                                    @if (l.TelLink.Length > 0)
                                    {
                                        <a href="@l.TelLink" class="btn btn-outline-primary icon-touch" aria-label="Kiracıyı ara"><i class="ti ti-phone"></i></a>
                                    }
                                }
                                else
                                {
                                    <span class="text-secondary"><i class="ti ti-lock me-1"></i>Kiracı: gizli kayıt</span>
                                }
                                @if (l.HasContract)
                                {
                                    <a asp-controller="Transaction" asp-action="Contract" asp-route-id="@l.TransactionId" target="_blank" rel="noopener"
                                       class="btn btn-outline-secondary ms-auto"><i class="ti ti-file-text me-1"></i> Kontrat</a>
                                }
                            </div>
                            @if (!l.IsMine)
                            {
                                <div class="text-secondary small"><i class="ti ti-user me-1"></i>@l.AgentName</div>
                            }
                        </div>
                    }
                </div>
            }
            <div class="card-footer">
                <a asp-controller="Transaction" asp-action="Index" asp-route-scope="@TransactionScope.LeaseEnding" class="btn btn-link px-0">
                    Tüm biten kiralar <i class="ti ti-chevron-right"></i>
                </a>
            </div>
        </div>
    </div>
</div>

<div class="text-secondary small mt-3">
    @(Model.CanSeeAll
        ? "Sayılar ofisteki tüm kayıtları içerir."
        : "Sayılar sizin kayıtlarınızı ve herkese açık kayıtları içerir.")
</div>
