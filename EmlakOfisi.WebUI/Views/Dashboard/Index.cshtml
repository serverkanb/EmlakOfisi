@{
    ViewData["Title"] = "Ana sayfa";
}

@* Kartlardaki sayılar görev 15'te (dashboard: sayilar) gerçek veriden gelecek. *@
<div class="row row-cards">
    <div class="col-6 col-lg-3">
        <div class="card card-sm">
            <div class="card-body d-flex align-items-center gap-3">
                <span class="avatar bg-primary-lt"><i class="ti ti-building-community"></i></span>
                <div>
                    <div class="text-secondary small">Aktif portföy</div>
                    <div class="h3 m-0">–</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card card-sm">
            <div class="card-body d-flex align-items-center gap-3">
                <span class="avatar bg-green-lt"><i class="ti ti-users"></i></span>
                <div>
                    <div class="text-secondary small">Müşteri</div>
                    <div class="h3 m-0">–</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card card-sm">
            <div class="card-body d-flex align-items-center gap-3">
                <span class="avatar bg-orange-lt"><i class="ti ti-calendar-event"></i></span>
                <div>
                    <div class="text-secondary small">Yaklaşan randevu</div>
                    <div class="h3 m-0">–</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card card-sm">
            <div class="card-body d-flex align-items-center gap-3">
                <span class="avatar bg-purple-lt"><i class="ti ti-receipt"></i></span>
                <div>
                    <div class="text-secondary small">Bu ay işlem</div>
                    <div class="h3 m-0">–</div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="card mt-3">
    <div class="card-body text-secondary">
        Hoş geldiniz. Müşteri ve portföy modülleri sırayla eklenecek; menüde "Yakında" yazan bölümler henüz hazır değil.
    </div>
</div>
