@model ContactDetailViewModel

@* Görüşme geçmişi: müşteriyi görebilen herkes okur; ekleme formu sadece sahibi ve yöneticilere görünür.
   Asıl kontrol ActivityController'da (serviste) yapılır. *@
<div class="card" id="gorusmeler">
    <div class="card-header">
        <h3 class="card-title"><i class="ti ti-history me-1"></i> Görüşme geçmişi</h3>
        <span class="badge bg-secondary-lt ms-2">@Model.Activities.Count</span>
    </div>

    @if (Model.CanAddActivity)
    {
        <div class="card-body border-bottom">
            <form method="post" asp-controller="Activity" asp-action="Create" asp-route-contactId="@Model.Summary.ContactId">
                <div class="row g-2">
                    <div class="col-12 col-sm-6">
                        <label class="form-label" for="NewActivity_Type">Tür</label>
                        <select id="NewActivity_Type" name="Type" class="form-select form-select-lg">
                            @foreach (var type in ActivityTypes.All)
                            {
                                <option value="@type" selected="@(type == Model.NewActivity.Type)">@ActivityTypes.Label(type)</option>
                            }
                        </select>
                    </div>
                    <div class="col-12 col-sm-6">
                        <label class="form-label" for="NewActivity_Date">Tarih</label>
                        <input id="NewActivity_Date" name="ActivityDate" type="datetime-local" class="form-control form-control-lg"
                               value="@((Model.NewActivity.ActivityDate ?? DateTime.Now).ToString("yyyy-MM-ddTHH:mm", System.Globalization.CultureInfo.InvariantCulture))" required />
                    </div>
                    <div class="col-12">
                        <label class="form-label" for="NewActivity_Description">Not</label>
                        <textarea id="NewActivity_Description" name="Description" rows="3" maxlength="2000" required data-mic
                                  class="form-control" placeholder="Ne konuşuldu? Sonraki adım ne?"></textarea>
                    </div>
                    <div class="col-12">
                        <button type="submit" class="btn btn-primary w-100 w-sm-auto">
                            <i class="ti ti-plus me-1"></i> Görüşmeyi kaydet
                        </button>
                    </div>
                </div>
            </form>
        </div>
    }

    @if (Model.Activities.Count == 0)
    {
        <div class="card-body text-secondary">Henüz görüşme kaydı yok.</div>
    }
    else
    {
        <div class="list-group list-group-flush">
            @foreach (var a in Model.Activities)
            {
                <div class="list-group-item">
                    <div class="d-flex gap-3">
                        <span class="avatar avatar-sm bg-primary-lt flex-shrink-0"><i class="ti @a.Icon"></i></span>
                        <div class="flex-fill" style="min-width: 0;">
                            <div class="d-flex flex-wrap justify-content-between gap-1">
                                <strong>@a.TypeLabel</strong>
                                <span class="text-secondary small">@a.ActivityDate.ToString("dd.MM.yyyy HH:mm")</span>
                            </div>
                            <div class="text-break" style="white-space: pre-line;">@a.Description</div>
                            <div class="d-flex justify-content-between align-items-center mt-1">
                                <span class="text-secondary small">@a.UserName</span>
                                @if (a.CanDelete)
                                {
                                    <form method="post" asp-controller="Activity" asp-action="Delete" asp-route-id="@a.ActivityId"
                                          onsubmit="return confirm('Bu görüşme kaydı silinsin mi? Geri alınamaz.');">
                                        <button type="submit" class="btn btn-ghost-danger activity-delete" aria-label="Görüşmeyi sil">
                                            <i class="ti ti-trash"></i>
                                        </button>
                                    </form>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
