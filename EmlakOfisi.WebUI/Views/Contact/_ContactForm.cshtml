@using EmlakOfisi.EntityLayer.Enums
@model ContactFormViewModel

@* Ekleme ve düzenleme formunun ortak alanları. Mobilde tek sütun, büyük dokunma alanları. *@
<div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

@if (ViewBag.DuplicateContactId is int duplicateId)
{
    <div class="alert alert-warning" role="alert">
        <i class="ti ti-alert-triangle me-1"></i>
        Bu telefonla kayıtlı bir müşteri zaten var.
        <a asp-action="Detail" asp-route-id="@duplicateId" class="alert-link">Kaydı aç</a>
    </div>
}

<div class="row g-3">
    <div class="col-12 col-sm-6">
        <label asp-for="Name" class="form-label required"></label>
        <input asp-for="Name" class="form-control form-control-lg" autocomplete="off" />
        <span asp-validation-for="Name" class="text-danger small"></span>
    </div>
    <div class="col-12 col-sm-6">
        <label asp-for="Surname" class="form-label required"></label>
        <input asp-for="Surname" class="form-control form-control-lg" autocomplete="off" />
        <span asp-validation-for="Surname" class="text-danger small"></span>
    </div>
    <div class="col-12 col-sm-6">
        <label asp-for="Phone" class="form-label required"></label>
        <input asp-for="Phone" type="tel" inputmode="numeric" pattern="[0-9 ]*" data-digits-only
               class="form-control form-control-lg" placeholder="05321112233" autocomplete="off" />
        <div class="form-hint">Sadece rakam girin.</div>
        <span asp-validation-for="Phone" class="text-danger small"></span>
    </div>
    <div class="col-12 col-sm-6">
        <label asp-for="Phone2" class="form-label"></label>
        <input asp-for="Phone2" type="tel" inputmode="numeric" pattern="[0-9 ]*" data-digits-only
               class="form-control form-control-lg" autocomplete="off" />
        <span asp-validation-for="Phone2" class="text-danger small"></span>
    </div>
    <div class="col-12">
        <label asp-for="Email" class="form-label"></label>
        <input asp-for="Email" type="email" inputmode="email" class="form-control form-control-lg" autocapitalize="none" autocomplete="off" />
        <span asp-validation-for="Email" class="text-danger small"></span>
    </div>

    <div class="col-12">
        <div class="form-label">Rol (birden fazla seçilebilir)</div>
        <div class="d-flex flex-wrap gap-3">
            <label class="form-check form-check-inline py-2 m-0">
                <input asp-for="IsBuyer" class="form-check-input" />
                <span class="form-check-label">Alıcı</span>
            </label>
            <label class="form-check form-check-inline py-2 m-0">
                <input asp-for="IsSeller" class="form-check-input" />
                <span class="form-check-label">Satıcı</span>
            </label>
            <label class="form-check form-check-inline py-2 m-0">
                <input asp-for="IsTenant" class="form-check-input" />
                <span class="form-check-label">Kiracı</span>
            </label>
            <label class="form-check form-check-inline py-2 m-0">
                <input asp-for="IsLandlord" class="form-check-input" />
                <span class="form-check-label">Mülk sahibi</span>
            </label>
        </div>
    </div>

    <div class="col-12">
        <div class="form-label">Kim görebilir?</div>
        <div class="form-selectgroup form-selectgroup-boxes d-flex flex-column flex-sm-row gap-2">
            <label class="form-selectgroup-item flex-fill">
                <input type="radio" asp-for="Visibility" value="@Visibility.OnlyMe" class="form-selectgroup-input" />
                <span class="form-selectgroup-label d-flex align-items-center p-3">
                    <i class="ti ti-lock me-2"></i>
                    <span>
                        <strong>Sadece Ben</strong><br />
                        <span class="text-secondary small">Siz ve ofis yöneticileri görür</span>
                    </span>
                </span>
            </label>
            <label class="form-selectgroup-item flex-fill">
                <input type="radio" asp-for="Visibility" value="@Visibility.Public" class="form-selectgroup-input" />
                <span class="form-selectgroup-label d-flex align-items-center p-3">
                    <i class="ti ti-world me-2"></i>
                    <span>
                        <strong>Herkese Açık</strong><br />
                        <span class="text-secondary small">Ofisteki herkes görür (düzenleyemez)</span>
                    </span>
                </span>
            </label>
        </div>
        <span asp-validation-for="Visibility" class="text-danger small"></span>
    </div>

    <div class="col-12">
        <label asp-for="Notes" class="form-label"></label>
        <textarea asp-for="Notes" rows="4" class="form-control"></textarea>
        <span asp-validation-for="Notes" class="text-danger small"></span>
    </div>
</div>
