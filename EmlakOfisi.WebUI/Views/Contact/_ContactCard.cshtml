@model ContactListItemViewModel

@* Mobil liste kartı: adına dokununca detay, altta büyük Ara / WhatsApp butonları *@
<div class="card mb-2">
    <div class="card-body p-3">
        <a asp-action="Detail" asp-route-id="@Model.ContactId" class="text-reset text-decoration-none d-block">
            <div class="fw-bold fs-3">@Model.FullName</div>
            <div class="text-secondary">@Model.Phone</div>
            <div class="mt-1 d-flex flex-wrap gap-1">
                <partial name="_ContactBadges" model="Model" />
            </div>
        </a>
        @if (Model.HasPhoneLinks)
        {
            <div class="d-flex gap-2 mt-3">
                <a href="@Model.TelLink" class="btn btn-outline-primary flex-fill contact-action">
                    <i class="ti ti-phone me-1"></i> Ara
                </a>
                <a href="@Model.WhatsAppLink" target="_blank" rel="noopener" class="btn btn-outline-success flex-fill contact-action">
                    <i class="ti ti-brand-whatsapp me-1"></i> WhatsApp
                </a>
            </div>
        }
    </div>
</div>
