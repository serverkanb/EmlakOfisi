@model LoginViewModel
@{
    ViewData["Title"] = "Giriş";
    Layout = null; // Giriş sayfası menüsüz, tek başına (Tabler görünümü görev 5'te)
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Emlak Ofisi</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
</head>
<body class="bg-light">
    <main class="container py-5" style="max-width: 420px;">
        <h1 class="h4 text-center mb-4">Emlak Ofisi</h1>

        <div class="card shadow-sm">
            <div class="card-body p-4">
                <h2 class="h5 mb-3">Giriş yap</h2>

                <form method="post" asp-controller="Login" asp-action="Index" asp-route-returnUrl="@ViewBag.ReturnUrl">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="UserName" class="form-label"></label>
                        <input asp-for="UserName" class="form-control form-control-lg" autocomplete="username" autocapitalize="none" autofocus />
                        <span asp-validation-for="UserName" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label"></label>
                        <input asp-for="Password" class="form-control form-control-lg" autocomplete="current-password" />
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="form-check mb-3">
                        <input asp-for="RememberMe" class="form-check-input" />
                        <label asp-for="RememberMe" class="form-check-label"></label>
                    </div>

                    <button type="submit" class="btn btn-primary btn-lg w-100">Giriş</button>
                </form>
            </div>
        </div>
    </main>
</body>
</html>
