@* İşlem sonrası bildirimler (TempData["Success"] / TempData["Error"]) *@
@if (TempData["Success"] is string success)
{
    <div class="alert alert-success alert-dismissible" role="alert">
        <i class="ti ti-check me-1"></i> @success
        <a class="btn-close" data-bs-dismiss="alert" aria-label="Kapat"></a>
    </div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger alert-dismissible" role="alert">
        <i class="ti ti-alert-circle me-1"></i> @error
        <a class="btn-close" data-bs-dismiss="alert" aria-label="Kapat"></a>
    </div>
}
