@using EmlakOfisi.EntityLayer.Constants
@{
    var current = ViewContext.RouteData.Values["controller"]?.ToString();
    string Active(string controller) => current == controller ? "active" : "";
    var isStaff = RoleNames.All.Any(r => User.IsInRole(r));
}

@* Mobil alt menü: sadece lg altı ekranlarda görünür. Hazır olmayan modüller pasif. *@
<nav class="bottom-nav d-lg-none" aria-label="Hızlı menü">
    <a class="bottom-nav-item @Active("Dashboard")" asp-controller="Dashboard" asp-action="Index">
        <i class="ti ti-home"></i><span>Ana sayfa</span>
    </a>
    @if (isStaff)
    {
        <a class="bottom-nav-item @Active("Contact")" asp-controller="Contact" asp-action="Index">
            <i class="ti ti-users"></i><span>Müşteri</span>
        </a>
    }
    else
    {
        <span class="bottom-nav-item disabled" aria-disabled="true">
            <i class="ti ti-users"></i><span>Müşteri</span>
        </span>
    }
    @if (isStaff)
    {
        <a class="bottom-nav-item @Active("Property")" asp-controller="Property" asp-action="Index">
            <i class="ti ti-building-community"></i><span>Portföy</span>
        </a>
    }
    else
    {
        <span class="bottom-nav-item disabled" aria-disabled="true">
            <i class="ti ti-building-community"></i><span>Portföy</span>
        </span>
    }
    @if (isStaff)
    {
        <a class="bottom-nav-item @Active("Appointment")" asp-controller="Appointment" asp-action="Index">
            <i class="ti ti-calendar-event"></i><span>Randevu</span>
        </a>
    }
    else
    {
        <span class="bottom-nav-item disabled" aria-disabled="true">
            <i class="ti ti-calendar-event"></i><span>Randevu</span>
        </span>
    }
</nav>
