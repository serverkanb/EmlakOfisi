@using EmlakOfisi.EntityLayer.Constants
@{
    var current = ViewContext.RouteData.Values["controller"]?.ToString();
    string Active(string controller) => current == controller ? "active" : "";
    // İş modülleri sadece ofis çalışanlarına (rolü olanlara) gösterilir; asıl kontrol controller'larda
    var isStaff = RoleNames.All.Any(r => User.IsInRole(r));
}

@* Henüz yapılmamış modüller "Yakında" olarak pasif görünür; her görev kendi satırını açar. *@
<ul class="navbar-nav pt-lg-3">
    <li class="nav-item @Active("Dashboard")">
        <a class="nav-link" asp-controller="Dashboard" asp-action="Index">
            <span class="nav-link-icon d-md-none d-lg-inline-block"><i class="ti ti-home fs-2"></i></span>
            <span class="nav-link-title">Ana sayfa</span>
        </a>
    </li>
    @if (isStaff)
    {
        <li class="nav-item @Active("Contact")">
            <a class="nav-link" asp-controller="Contact" asp-action="Index">
                <span class="nav-link-icon d-md-none d-lg-inline-block"><i class="ti ti-users fs-2"></i></span>
                <span class="nav-link-title">Müşteriler</span>
            </a>
        </li>
    }
    @if (isStaff)
    {
        <li class="nav-item @Active("Property")">
            <a class="nav-link" asp-controller="Property" asp-action="Index">
                <span class="nav-link-icon d-md-none d-lg-inline-block"><i class="ti ti-building-community fs-2"></i></span>
                <span class="nav-link-title">Portföyler</span>
            </a>
        </li>
    }
    <li class="nav-item">
        <a class="nav-link disabled" aria-disabled="true" tabindex="-1">
            <span class="nav-link-icon d-md-none d-lg-inline-block"><i class="ti ti-calendar-event fs-2"></i></span>
            <span class="nav-link-title">Randevular</span>
            <span class="badge badge-sm bg-secondary-lt ms-auto">Yakında</span>
        </a>
    </li>

    @if (User.IsInRole(RoleNames.Admin))
    {
        <li class="nav-item mt-lg-3">
            <span class="nav-link text-uppercase small text-secondary pe-none">Yönetim</span>
        </li>
        @* Rol atama, kullanıcı listesindeki "Roller" butonundan açılır *@
        <li class="nav-item @Active("AdminUser") @Active("RoleAssign")">
            <a class="nav-link" asp-controller="AdminUser" asp-action="Index">
                <span class="nav-link-icon d-md-none d-lg-inline-block"><i class="ti ti-user-cog fs-2"></i></span>
                <span class="nav-link-title">Kullanıcılar ve roller</span>
            </a>
        </li>
    }
</ul>
