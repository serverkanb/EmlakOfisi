@using EmlakOfisi.EntityLayer.Constants
@model AdminUserCreateViewModel
@{
    ViewData["Title"] = "Yeni kullanıcı";
}

<div class="card" style="max-width: 640px;">
    <div class="card-body">
        <form method="post" asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

            <div class="row g-3">
                <div class="col-12 col-sm-6">
                    <label asp-for="Name" class="form-label required"></label>
                    <input asp-for="Name" class="form-control" autocomplete="off" />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>
                <div class="col-12 col-sm-6">
                    <label asp-for="Surname" class="form-label required"></label>
                    <input asp-for="Surname" class="form-control" autocomplete="off" />
                    <span asp-validation-for="Surname" class="text-danger small"></span>
                </div>
                <div class="col-12 col-sm-6">
                    <label asp-for="UserName" class="form-label required"></label>
                    <input asp-for="UserName" class="form-control" autocomplete="off" autocapitalize="none" />
                    <span asp-validation-for="UserName" class="text-danger small"></span>
                </div>
                <div class="col-12 col-sm-6">
                    <label asp-for="Email" class="form-label required"></label>
                    <input asp-for="Email" type="email" class="form-control" autocomplete="off" autocapitalize="none" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>
                <div class="col-12 col-sm-6">
                    <label asp-for="Password" class="form-label required"></label>
                    <input asp-for="Password" class="form-control" autocomplete="new-password" />
                    <div class="form-hint">En az 8 karakter ve en az bir rakam.</div>
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>
                <div class="col-12 col-sm-6">
                    <label asp-for="Role" class="form-label required"></label>
                    <select asp-for="Role" class="form-select">
                        @foreach (var role in RoleNames.All)
                        {
                            <option value="@role">@RoleNames.Label(role)</option>
                        }
                    </select>
                    <span asp-validation-for="Role" class="text-danger small"></span>
                </div>
            </div>

            <div class="d-flex gap-2 mt-4">
                <button type="submit" class="btn btn-primary"><i class="ti ti-device-floppy me-1"></i> Kaydet</button>
                <a asp-action="Index" class="btn btn-link">Vazgeç</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
