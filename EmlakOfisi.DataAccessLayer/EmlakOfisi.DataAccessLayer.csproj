<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\EmlakOfisi.EntityLayer\EmlakOfisi.EntityLayer.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.14" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.14">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- Güvenlik: Microsoft.Data.SqlClient 6.1.7 dolaylı olarak açıklı Pkcs 9.0.11 getiriyor
         (GHSA-2fmv-rv2c-59x7, GHSA-846f-f764-76mx). Güncel sürüm doğrudan referansla kullanılıyor.
         EF Core/SqlClient güncel Pkcs'yi kendisi getirdiğinde bu satır kaldırılabilir. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
  </ItemGroup>

</Project>
